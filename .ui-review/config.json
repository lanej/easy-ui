{
  "version": 1,
  "baseURL": "http://127.0.0.1:4173",
  "enforceOnStop": false,
  "sourcePaths": [
    "easy-ui-react/src",
    "scripts/preview-metrics",
    ".storybook/public"
  ],
  "accessibility": true,
  "pages": [
    {
      "name": "main",
      "path": "/",
      "ready": "[aria-label=\"Parcels from multiple warehouses\"] [data-chart-state=\"ready\"] svg"
    },
    {
      "name": "stress",
      "path": "/layout.html",
      "ready": "[data-chart-state=\"ready\"] svg",
      "viewports": ["desktop", "mobile"]
    },
    {
      "name": "chart-composition",
      "path": "/chart-composition.html",
      "ready": "[data-chart-case=\"pair-b\"] [data-chart-state=\"ready\"] svg",
      "viewports": ["desktop", "mobile"]
    },
    {
      "name": "chart-composition-large",
      "path": "/chart-composition.html?large=1&stress=1",
      "ready": "[data-chart-case=\"pair-b\"] [data-chart-state=\"ready\"] svg",
      "viewports": ["desktop", "mobile"]
    },
    {
      "name": "native-composition",
      "path": "/native-regressions.html",
      "ready": "[data-native-ready]",
      "viewports": ["desktop", "mobile"]
    },
    {
      "name": "native-composition-large",
      "path": "/native-regressions.html?large=1&stress=1",
      "ready": "[data-native-ready]",
      "viewports": ["desktop", "mobile"]
    },
    {
      "name": "score-composition",
      "path": "/score-composition.html",
      "ready": "[data-score-node=\"result\"] [data-sentiment=\"negative\"]",
      "viewports": ["desktop", "mobile", "4k"],
      "checkpoints": [
        {
          "name": "default",
          "setup": ".ui-review/checkpoints/score-default.mjs"
        },
        {
          "name": "expanded-large",
          "setup": ".ui-review/checkpoints/score-expanded-large.mjs"
        },
        {
          "name": "dark",
          "setup": ".ui-review/checkpoints/score-dark.mjs"
        }
      ]
    },
    {
      "name": "score-signals-collapsed",
      "path": "/score-composition.html",
      "ready": "[data-score-node=\"result\"] [data-sentiment=\"negative\"]",
      "viewports": ["desktop", "mobile", "4k"],
      "checkpoints": [
        {
          "name": "collapsed",
          "setup": ".ui-review/checkpoints/score-signals-collapsed.mjs"
        }
      ]
    },
    {
      "name": "score-contributions-collapsed",
      "path": "/score-composition.html",
      "ready": "[data-score-node=\"result\"] [data-sentiment=\"negative\"]",
      "viewports": ["desktop", "mobile", "4k"],
      "checkpoints": [
        {
          "name": "collapsed",
          "setup": ".ui-review/checkpoints/score-contributions-collapsed.mjs"
        }
      ]
    },
    {
      "name": "score-result-focus",
      "path": "/score-composition.html",
      "ready": "[data-score-node=\"result\"] [data-sentiment=\"negative\"]",
      "viewports": ["desktop", "mobile", "4k"],
      "checkpoints": [
        {
          "name": "collapsed",
          "setup": ".ui-review/checkpoints/score-result-focus.mjs"
        }
      ]
    },
    {
      "name": "score-chart-details",
      "path": "/score-composition.html?rich=1",
      "ready": "[data-score-node=\"result\"] [data-sentiment=\"negative\"]",
      "viewports": ["desktop", "mobile", "4k"],
      "checkpoints": [
        {
          "name": "expanded",
          "setup": ".ui-review/checkpoints/score-charts-expanded.mjs"
        },
        {
          "name": "large",
          "setup": ".ui-review/checkpoints/score-charts-large.mjs"
        },
        {
          "name": "dark",
          "setup": ".ui-review/checkpoints/score-charts-dark.mjs"
        }
      ]
    },
    {
      "name": "dependency-graph",
      "path": "/dependency-graph.html",
      "ready": "[data-dependency-graph] [data-graph-node]",
      "viewports": ["desktop", "mobile"]
    },
    {
      "name": "dependency-graph-large-dark",
      "path": "/dependency-graph.html?large=1&dark=1",
      "ready": "[data-dependency-graph] [data-graph-node]",
      "viewports": ["desktop", "mobile"]
    },
    {
      "name": "dependency-graph-summary",
      "path": "/dependency-graph.html?summary=1",
      "ready": "[data-resource-changes][data-presentation=\"summary\"]",
      "viewports": ["desktop", "mobile"]
    },
    {
      "name": "dependency-graph-specific",
      "path": "/dependency-graph.html?specific=1",
      "ready": "[data-resource-changes] [data-diff]",
      "viewports": ["desktop", "mobile"]
    },
    {
      "name": "dependency-graph-inline",
      "path": "/dependency-graph.html?inline=1",
      "ready": "[data-graph-card-diff] [data-diff]",
      "viewports": ["desktop", "mobile"]
    },
    {
      "name": "dependency-graph-inline-large-dark",
      "path": "/dependency-graph.html?inline=1&large=1&dark=1",
      "ready": "[data-graph-card-diff] [data-diff]",
      "viewports": ["desktop", "mobile"]
    },
    {
      "name": "dependency-graph-overview",
      "path": "/dependency-graph.html?overview=1",
      "ready": "[data-dependency-graph] [data-graph-node]",
      "viewports": ["desktop", "mobile"]
    },
    {
      "name": "dependency-graph-folded",
      "path": "/dependency-graph.html?folded=1",
      "ready": "[data-dependency-graph] [data-graph-node]",
      "viewports": ["desktop", "mobile"]
    }
  ],
  "viewports": [
    {
      "name": "desktop",
      "width": 1440,
      "height": 1000
    },
    {
      "name": "mobile",
      "width": 320,
      "height": 844
    },
    {
      "name": "4k",
      "width": 3840,
      "height": 2160
    }
  ],
  "detailCapture": {
    "width": 1024,
    "height": 800,
    "overlap": 64,
    "maxTiles": 160
  }
}
