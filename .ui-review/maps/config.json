{
  "version": 1,
  "baseURL": "http://127.0.0.1:4174",
  "enforceOnStop": false,
  "sourcePaths": [
    "easy-ui-react/src/NetworkMap",
    "easy-ui-react/src/visualization",
    "scripts/preview-maps",
    ".storybook/public"
  ],
  "accessibility": true,
  "timeoutMs": 30000,
  "pages": [
    {
      "name": "composition",
      "path": "/composition.html",
      "ready": "[data-map-idle=\"true\"]"
    },
    {
      "name": "large-text",
      "path": "/composition.html?large=1",
      "ready": "[data-map-idle=\"true\"]"
    }
  ],
  "viewports": [
    { "name": "desktop", "width": 1440, "height": 1000 },
    { "name": "mobile", "width": 390, "height": 760 }
  ],
  "detailCapture": {
    "width": 1024,
    "height": 800,
    "overlap": 64,
    "maxTiles": 80
  }
}
