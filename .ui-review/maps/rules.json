[
  {
    "id": "map-readable-annotations",
    "type": "min-font-size",
    "selector": "main",
    "min": 12,
    "severity": "error",
    "reason": "Map labels, exact data, attribution and controls retain the declared dense-annotation floor.",
    "designRules": ["DR-007"]
  },
  {
    "id": "map-readable-prose",
    "type": "min-font-size",
    "selector": "main > p, main h1, main h2, main h3, #external-selection p",
    "min": 14,
    "severity": "error",
    "reason": "Visible headings and selected-record prose remain readable independently of annotation density.",
    "designRules": ["DR-007"]
  },
  {
    "id": "map-label-bounds",
    "type": "within-bounds",
    "selector": "[data-map-label=\"true\"]",
    "container": "[data-map-state]",
    "tolerance": 1,
    "optional": true,
    "severity": "error",
    "reason": "Measured visible map labels must stay within the viewport at default and larger text sizes.",
    "designRules": ["DR-006", "DR-007"]
  },
  {
    "id": "map-composed-parts",
    "pages": ["composition", "large-text"],
    "type": "required-elements",
    "selector": ".composition-page",
    "required": [
      "[data-map-state]",
      ".composition-controls",
      "#external-map-data",
      "#external-selection"
    ],
    "severity": "error",
    "reason": "A composed investigation retains its surface, independent controls, selected record and equivalent data.",
    "designRules": ["DR-006", "DR-007"]
  },
  {
    "id": "map-selection-outside-surface",
    "pages": ["composition", "large-text"],
    "type": "relative-position",
    "selector": ".composition-page",
    "from": "[data-map-state]",
    "to": "#external-selection",
    "relation": "above",
    "minGap": 0,
    "maxGap": 32,
    "tolerance": 1,
    "severity": "error",
    "reason": "Selected-record content follows the viewport without covering geography, navigation or attribution.",
    "designRules": ["DR-006", "DR-015"]
  },
  {
    "id": "journey-map-with-insets",
    "pages": ["journey-sections", "journey-sections-large-text"],
    "type": "required-elements",
    "selector": "[data-journey-zoom-example]",
    "required": [
      "[data-map-geography] > [data-map-state]",
      "[data-map-zoom-sections]"
    ],
    "severity": "error",
    "reason": "One geographic frame keeps the full journey visible with an embedded inset layer.",
    "designRules": ["DR-006", "DR-007"]
  },
  {
    "pages": ["journey-sections", "journey-sections-large-text"],
    "type": "required-elements",
    "selector": "[data-journey-zoom-example]",
    "severity": "error",
    "designRules": ["DR-006", "DR-007"],
    "id": "journey-desktop-insets",
    "viewports": ["desktop"],
    "required": [
      "[data-map-zoom-section=\"origin\"] [data-map-state]",
      "[data-map-zoom-section=\"destination\"] [data-map-state]"
    ],
    "reason": "Desktop shows both embedded origin and destination close-ups."
  },
  {
    "pages": ["journey-sections", "journey-sections-large-text"],
    "type": "required-elements",
    "selector": "[data-journey-zoom-example]",
    "severity": "error",
    "designRules": ["DR-006", "DR-007"],
    "id": "journey-mobile-inset",
    "viewports": ["mobile"],
    "required": [
      "[data-map-zoom-section][data-active=\"true\"] [data-map-state]",
      "[data-map-zoom-sections] [role=\"group\"] button"
    ],
    "reason": "Mobile shows the active inset with controls to choose the other close-up, while retaining the overview."
  },
  {
    "id": "journey-section-bounds",
    "pages": ["journey-sections", "journey-sections-large-text"],
    "type": "within-bounds",
    "selector": "[data-map-zoom-section]",
    "container": "[data-map-geography]",
    "tolerance": 1,
    "severity": "error",
    "reason": "Inset cards must remain embedded within the geographic viewport at narrow and wide widths.",
    "designRules": ["DR-007"]
  }
]
