[
  {
    "id": "chart-readable-annotations",
    "type": "min-font-size",
    "selector": "main",
    "min": 12,
    "severity": "error",
    "reason": "Dense chart annotations, captions and exact tables use at least 12 CSS px; page prose and headings have a separate 14 px minimum. No smaller mobile type.",
    "designRules": ["DR-007"]
  },
  {
    "id": "baseline-content-clipping",
    "type": "no-clip",
    "selector": "main p, main td, main th, main label, main button, main [data-viewrule=label]",
    "optional": true,
    "severity": "warning",
    "reason": "Inspect clipped content and preserve essential labels; intentional previews can use a scoped exception.",
    "designRules": ["DR-006", "DR-007"]
  },
  {
    "id": "baseline-header-height",
    "type": "max-height",
    "selector": "body > header, [data-viewrule=page-header]",
    "max": 160,
    "optional": true,
    "severity": "warning",
    "reason": "Review headers taller than 160 CSS px so framing and controls leave space for the primary task.",
    "designRules": ["DR-008"]
  },
  {
    "id": "baseline-control-size",
    "type": "min-size",
    "selector": "main button, main [role=button], main select, main input:not([type=hidden]):not([type=checkbox]):not([type=radio])",
    "minWidth": 24,
    "minHeight": 24,
    "optional": true,
    "severity": "warning",
    "reason": "Keep controls usable as density increases. Bounds under 24 CSS px need review; this does not implement WCAG target geometry or its spacing, equivalent-control, inline, native, and essential exceptions.",
    "designRules": ["DR-007"]
  },
  {
    "id": "baseline-prose-alignment",
    "type": "style",
    "selector": "main [data-viewrule=prose] p",
    "property": "text-align",
    "allowed": ["left", "right", "start", "end", "center", "match-parent"],
    "optional": true,
    "severity": "warning",
    "reason": "Avoid fully justified prose and its uneven word spacing. This is a scoped default, not a WCAG 1.4.8 conformance test.",
    "designRules": ["DR-007"]
  },
  {
    "id": "page-readable-prose",
    "type": "min-font-size",
    "selector": ".note, h1, h2, .layout-review > header",
    "min": 14,
    "severity": "error",
    "reason": "Keep explanatory prose and headings at least 14 CSS px.",
    "designRules": ["DR-007"]
  },
  {
    "id": "chart-svg-bounds",
    "type": "within-bounds",
    "selector": "[data-chart-state=\"ready\"] svg text",
    "container": "svg",
    "tolerance": 1,
    "severity": "error",
    "reason": "Chart labels must stay inside their SVG viewport.",
    "designRules": ["DR-006", "DR-007"],
    "pages": [
      "main",
      "stress",
      "chart-composition",
      "chart-composition-large",
      "score-chart-details"
    ]
  },
  {
    "id": "native-axis-bounds",
    "type": "within-bounds",
    "selector": "[data-chart-value-axis] > span, [data-chart-time-axis] > span",
    "container": "[data-chart-value-axis], [data-chart-time-axis]",
    "tolerance": 1,
    "severity": "error",
    "reason": "Large formatted values and complete dates must fit the native axis.",
    "designRules": ["DR-006", "DR-007"],
    "pages": [
      "main",
      "stress",
      "native-composition",
      "native-composition-large"
    ]
  },
  {
    "id": "native-axis-overlap",
    "type": "no-overlap",
    "selector": "[data-chart-value-axis] > span, [data-chart-time-axis] > span",
    "severity": "error",
    "reason": "Wrapped native axis labels must remain distinct.",
    "designRules": ["DR-006", "DR-007"],
    "pages": [
      "main",
      "stress",
      "native-composition",
      "native-composition-large"
    ]
  },
  {
    "id": "example-heading-height",
    "type": "max-height",
    "selector": ".example-content > h2",
    "max": 80,
    "pages": ["main"],
    "severity": "error",
    "reason": "Example headings may wrap at 320 px but must not stretch into unused card space.",
    "designRules": ["DR-008"]
  },
  {
    "id": "example-caption-height",
    "type": "max-height",
    "selector": ".example-content > .panel-note",
    "max": 120,
    "pages": ["main"],
    "severity": "error",
    "reason": "Example captions may wrap but must not grow to fill the card.",
    "designRules": ["DR-008"]
  },
  {
    "id": "chart-label-overlap",
    "type": "no-overlap",
    "selector": "[data-chart-state=\"ready\"] svg text",
    "severity": "warning",
    "reason": "Review intersecting SVG text boxes; rotated labels and deliberate label layers require visual interpretation.",
    "designRules": ["DR-006", "DR-007"],
    "pages": [
      "main",
      "stress",
      "chart-composition",
      "chart-composition-large",
      "score-chart-details"
    ]
  },
  {
    "id": "service-mix-heading-height",
    "type": "max-height",
    "selector": "[aria-label=\"Service mix\"] h2",
    "max": 32,
    "pages": ["main"],
    "severity": "error",
    "reason": "This short heading fits one line at the minimum viewport; growth indicates accidental card stretching.",
    "designRules": ["DR-008"]
  },
  {
    "id": "score-nodes-visible",
    "type": "required-elements",
    "selector": "[data-score-example] [data-score-layout]",
    "severity": "error",
    "reason": "Keep all four signals, two contributions, and the result available in the finite comparison, including below the fold on mobile.",
    "designRules": ["DR-006", "DR-007"],
    "pages": ["score-composition", "score-chart-details"],
    "required": [
      "[data-score-node=\"signal\"][data-score-id=\"dimensions\"]",
      "[data-score-node=\"signal\"][data-score-id=\"weight\"]",
      "[data-score-node=\"signal\"][data-score-id=\"ratio\"]",
      "[data-score-node=\"signal\"][data-score-id=\"burst\"]",
      "[data-score-node=\"contribution\"][data-score-id=\"underdeclaration\"]",
      "[data-score-node=\"contribution\"][data-score-id=\"international\"]",
      "[data-score-node=\"result\"][data-score-id=\"result\"]"
    ]
  },
  {
    "id": "score-nodes-within-layout",
    "type": "within-bounds",
    "selector": "[data-score-example] [data-score-node]",
    "severity": "error",
    "reason": "Node boxes must fit the composition without horizontal loss at 320px or with larger text.",
    "designRules": ["DR-006", "DR-015"],
    "pages": [
      "score-composition",
      "score-signals-collapsed",
      "score-contributions-collapsed",
      "score-result-focus",
      "score-chart-details"
    ],
    "container": "[data-score-layout]",
    "tolerance": 1
  },
  {
    "id": "score-nodes-distinct",
    "type": "no-overlap",
    "selector": "[data-score-example] [data-score-node]",
    "severity": "error",
    "reason": "Signal boxes, contribution cards, and the result must remain distinct when text expands.",
    "designRules": ["DR-006", "DR-015"],
    "pages": [
      "score-composition",
      "score-signals-collapsed",
      "score-contributions-collapsed",
      "score-result-focus",
      "score-chart-details"
    ]
  },
  {
    "id": "score-node-content-clipping",
    "type": "no-clip",
    "selector": "[data-score-example] [data-score-node], [data-score-example] [data-score-node] > div, [data-score-example] [data-viewrule=\"score-primary\"], [data-score-example] [data-score-node] strong, [data-score-example] [data-score-node] [data-sentiment], [data-score-example] [data-score-status-label], [data-score-example] [data-score-fill-label], [data-score-example] [data-score-node=\"result\"] > div > span, [data-score-example] [data-score-node=\"result\"] > div > div",
    "severity": "error",
    "reason": "Exact values, decisions, and expanded explanations must not be clipped.",
    "designRules": ["DR-006", "DR-015"],
    "pages": [
      "score-composition",
      "score-signals-collapsed",
      "score-contributions-collapsed",
      "score-result-focus",
      "score-chart-details"
    ]
  },
  {
    "id": "score-readable-primary-text",
    "type": "min-font-size",
    "selector": ".score-intro, [data-viewrule=\"score-primary\"], [data-score-node] strong, [data-score-node=\"result\"]",
    "severity": "error",
    "reason": "Primary observations, contributions, outcome text, and result context retain the 14px prose floor.",
    "designRules": ["DR-007"],
    "pages": [
      "score-composition",
      "score-signals-collapsed",
      "score-contributions-collapsed",
      "score-result-focus",
      "score-chart-details"
    ],
    "min": 14
  },
  {
    "id": "score-disclosure-targets",
    "type": "min-size",
    "selector": "[data-score-example] button, [data-score-example] summary",
    "severity": "error",
    "reason": "Explanations retain 44px touch targets at every text size.",
    "designRules": ["DR-007", "DR-014"],
    "pages": [
      "score-composition",
      "score-signals-collapsed",
      "score-contributions-collapsed",
      "score-result-focus",
      "score-chart-details"
    ],
    "minWidth": 44,
    "minHeight": 44
  },
  {
    "id": "score-signals-collapsed-visible",
    "type": "required-elements",
    "selector": "[data-score-example] [data-score-layout]",
    "severity": "error",
    "reason": "Only explicitly collapsed columns hide their nodes; the result and both reopen controls remain available.",
    "designRules": ["DR-006", "DR-007"],
    "pages": ["score-signals-collapsed"],
    "required": [
      "[data-score-column=\"signals\"] > div > button",
      "[data-score-column=\"contributions\"] > div > button",
      "[data-score-node=\"result\"]",
      "[data-score-id=\"underdeclaration\"]",
      "[data-score-id=\"international\"]"
    ]
  },
  {
    "id": "score-contributions-collapsed-visible",
    "type": "required-elements",
    "selector": "[data-score-example] [data-score-layout]",
    "severity": "error",
    "reason": "Only explicitly collapsed columns hide their nodes; the result and both reopen controls remain available.",
    "designRules": ["DR-006", "DR-007"],
    "pages": ["score-contributions-collapsed"],
    "required": [
      "[data-score-column=\"signals\"] > div > button",
      "[data-score-column=\"contributions\"] > div > button",
      "[data-score-node=\"result\"]",
      "[data-score-id=\"dimensions\"]",
      "[data-score-id=\"weight\"]",
      "[data-score-id=\"ratio\"]",
      "[data-score-id=\"burst\"]"
    ]
  },
  {
    "id": "score-result-focus-visible",
    "type": "required-elements",
    "selector": "[data-score-example] [data-score-layout]",
    "severity": "error",
    "reason": "Only explicitly collapsed columns hide their nodes; the result and both reopen controls remain available.",
    "designRules": ["DR-006", "DR-007"],
    "pages": ["score-result-focus"],
    "required": [
      "[data-score-column=\"signals\"] > div > button",
      "[data-score-column=\"contributions\"] > div > button",
      "[data-score-node=\"result\"]"
    ]
  },
  {
    "id": "score-rich-charts-present",
    "type": "required-elements",
    "selector": "[data-score-example]",
    "required": [
      "[data-score-chart=\"history\"] [data-chart-state=\"ready\"] svg",
      "[data-score-chart=\"response\"] [data-chart-state=\"ready\"] svg"
    ],
    "severity": "error",
    "reason": "Expanded score examples must render both charts rather than pass on empty loading states.",
    "designRules": ["DR-006", "DR-007"],
    "pages": ["score-chart-details"]
  }
]
